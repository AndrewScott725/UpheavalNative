[configuration]
entry_symbol = "upheaval_crowd_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug = "res://native/crowd_gdextension/bin/libupheaval_crowd.macos.template_debug.universal.dylib"
macos.release = "res://native/crowd_gdextension/bin/libupheaval_crowd.macos.template_release.universal.dylib"
windows.debug.x86_64 = "res://native/crowd_gdextension/bin/upheaval_crowd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://native/crowd_gdextension/bin/upheaval_crowd.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://native/crowd_gdextension/bin/libupheaval_crowd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/crowd_gdextension/bin/libupheaval_crowd.linux.template_release.x86_64.so"
